# Tema Quanta UFSCar para org-re-reveal (reveal.js 6).
# Uso: adicione este repositório como submódulo em `quanta/` e, no .org:
#   #+SETUPFILE: quanta/quanta.setup
# Os caminhos abaixo (quanta/...) são relativos ao HTML exportado.
#+options: H:2 ':t toc:nil timestamp:nil num:nil date:nil
#+options: reveal_width:1920 reveal_height:1080 reveal_slide_number:c/t

#+REVEAL_ROOT: https://cdn.jsdelivr.net/npm/reveal.js@6
#+REVEAL_VERSION: 6
#+REVEAL_THEME: white
#+REVEAL_EXTRA_CSS: quanta/custom.css
#+REVEAL_MARGIN: 0.02
#+REVEAL_MIN_SCALE: 0.5
#+REVEAL_MAX_SCALE: 35

#+REVEAL_TITLE_SLIDE: <img class="logo" src="quanta/img/logo.svg" alt="Quanta UFSCar" />
#+REVEAL_TITLE_SLIDE: <h2 class="title">%t</h2>
#+REVEAL_TITLE_SLIDE: <h3 class="author">%a</h3>
#+REVEAL_TITLE_SLIDE: <h3 class="email">%e</h3>

# Favicon: logo reduzida, branca em tema escuro (img/favicon.svg)
#+HTML_HEAD: <link rel="icon" type="image/svg+xml" href="quanta/img/favicon.svg" />

# Plotly no <head>: os gráficos embutidos nos slides chamam Plotly.newPlot
# durante o carregamento da página.
#+HTML_HEAD: <script src="https://cdn.plot.ly/plotly-4.1.1.min.js"></script>
# Depois de Reveal.initialize: fundos quanta-* sem piscar (quanta.js).
#+REVEAL_POSTSCRIPT: <script src="quanta/quanta.js"></script>

# Matemática com KaTeX. RevealMath sozinho é a variante MathJax 2, que
# ignora a configuração katex; por isso o plugin entra por REVEAL_ADD_PLUGIN
# como RevealMath.KaTeX. O nome "math" faz o org-re-reveal não carregar o
# MathJax.
#   \id{ID}{tex}       elemento com data-id, pareado pelo auto-animate
#   \idc{ID}{COR}{tex} idem, com data-cor=COR (cores em custom.css e, na
#                      exportação, as de my/latex-colors-alist)
# Outras opções em REVEAL_INIT_SCRIPT no .org precisam começar com vírgula.
#+REVEAL_PLUGINS: (notes)
#+REVEAL_ADD_PLUGIN: math RevealMath.KaTeX https://cdn.jsdelivr.net/npm/reveal.js@6/dist/plugin/math.js
#+REVEAL_INIT_SCRIPT: katex: { trust: true, strict: false,
#+REVEAL_INIT_SCRIPT:   macros: { '\\id': '\\htmlData{id=#1}{#2}', '\\idc': '\\htmlData{id=#1, cor=#2}{#3}' } },
#+REVEAL_INIT_SCRIPT: autoAnimateDuration: 1.2

# Cores de destaque (definidas em custom.css)
#+MACRO: azul @@html:<span class="azul">$1</span>@@
#+MACRO: laranja @@html:<span class="laranja">$1</span>@@
#+MACRO: plotly @@html:<div id="$1"></div><script> fetch("$2") .then(r => r.json()) .then(fig => Plotly.newPlot("$1", fig.data, fig.layout, {frames: fig.frames || []})); </script>@@
